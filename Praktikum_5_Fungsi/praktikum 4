def buat_biodata(nama, umur, jurusan):
    print("Nama:", nama)
    print("Umur:", umur)
    print("Jurusan:", jurusan)
    print()

# Positional argument
buat_biodata("Andi", 20, "Sistem Informasi")

# Keyword argument dengan urutan berbeda
buat_biodata(jurusan="Sistem Informasi", nama="Andi", umur=20)