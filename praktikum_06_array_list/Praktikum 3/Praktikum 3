daftar_matkul = ["Algoritma", "Tipe Data"]

# 1. Menambahkan Basis Data di akhir list
daftar_matkul.append("Basis Data")
print(daftar_matkul)

# 2. Menyisipkan Pemrograman pada indeks 1
daftar_matkul.insert(1, "Pemrograman")
print(daftar_matkul)

# 3. Menghapus elemen pada indeks 0
del daftar_matkul[0]
print(daftar_matkul)

# 4. Menghapus elemen terakhir menggunakan pop()
terhapus = daftar_matkul.pop()
print("Terhapus:", terhapus)
print(daftar_matkul)